# ─── Base de datos (PostgreSQL) ─────────────────────────────────────────────
# Si esta variable NO está definida, el dashboard arranca en MODO DEMO con datos
# sintéticos en memoria (útil para previsualizar la UI sin infraestructura).
DATABASE_URL="postgresql://autods:autods@localhost:5432/autods?schema=public"

# ─── Redis / Cola de trabajos 24/7 (BullMQ) ─────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Scraper microservice (FastAPI + Playwright) ────────────────────────────
SCRAPER_SERVICE_URL="http://localhost:8000"
# Si el microservicio no está levantado, src/lib/scraper.ts usa el extractor
# interno (cheerio-less / fetch) o el generador de datos demo.
SCRAPER_MODE="auto" # auto | service | local | demo

# Rotación de proxies para anti-bot (una entrada por línea, separadas por coma)
PROXY_LIST=""
PROXY_ROTATION="round-robin"
# ── Proxies residenciales (para extracción real sin bloqueos) ────────────────
# Opción A) Gateway rotativo de un proveedor (recomendado). Rellena y descomenta.
# PROXY_PROVIDER="brightdata"        # brightdata | oxylabs | smartproxy | iproyal | webshare | custom
# PROXY_USERNAME="brd-customer-hl_XXXXXXX-zone-residential"
# PROXY_PASSWORD="tu-password"
# PROXY_COUNTRY="es"
# PROXY_SESSIONS="12"
# PROXY_SESSION_TTL_MIN="10"
# Opción B) Lista explícita (una entrada por coma)
# PROXY_LIST="http://usuario:clave@host1:port,http://usuario:clave@host2:port"
PROXY_REQUIRED="false"              # true = nunca salir con la IP del servidor
 # round-robin | random

# ─── Shopify ────────────────────────────────────────────────────────────────
SHOPIFY_API_VERSION="2025-01"
SHOPIFY_WEBHOOK_SECRET="whsec_demo_secret"

# ─── WooCommerce (por tienda, se guarda cifrado en la tabla Store) ──────────
WOO_DEFAULT_CONSUMER_KEY=""
WOO_DEFAULT_CONSUMER_SECRET=""

# ─── Auth (NextAuth) ────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-de-32-chars"
# true = el middleware protege /dashboard, /products, /orders... (redirige a /login)
# ── Correo transaccional ──────────────────────────────────────────────────────
# Opción recomendada: el buzón que ya tienes (Gmail, Zoho, tu hosting, Amazon
# SES…). Rellena estos cuatro datos y los enlaces de verificación salen solos.
#   · Puerto 587 → STARTTLS (por defecto) · Puerto 465 → TLS directo
#   · Para ver los correos en tu ordenador sin buzón: npm run mail:dev-server
#     y pon SMTP_HOST="127.0.0.1", SMTP_PORT="2525", SMTP_TLS="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# SMTP_SECURE="true"        # sólo para 465 (TLS directo desde el primer byte)
# SMTP_TLS="false"          # desactivar el cifrado (sólo relays internos)
# SMTP_TLS_INSECURE="true"  # aceptar certificados no verificados (sólo pruebas)
# MAIL_FROM="Tu Tienda <no-reply@tudominio.com>"

# Alternativas: RESEND_API_KEY + MAIL_FROM, o MAIL_WEBHOOK_URL (relay propio).

# ── Panel del operador ────────────────────────────────────────────────────────
# Con AUTH_ENABLED="false" el panel /admin queda en SÓLO LECTURA (los correos de
# los clientes salen ocultos y no se pueden cambiar planes ni claves). Si eres el
# único dueño de la instalación y quieres permisos completos sin iniciar sesión,
# pon true. NUNCA en un SaaS abierto: cualquiera con la URL sería administrador.
LOCAL_ADMIN_MODE="false"

# ── Cambio de divisa ──────────────────────────────────────────────────────────
# El motor de precios trabaja en EUR y los proveedores cobran en su divisa. Por
# defecto las tasas se DESCARGAN SOLAS de los tipos de referencia del BCE
# (gratis, sin clave ni registro) al arrancar el worker y cada FX_REFRESH_HOURS.
#   · FX_AUTO="false"   → no descargar nada
#   · FX_RATES='{...}'  → fijarlas a mano: manda sobre la descarga automática
#   · FX_ENABLED="false"→ trabajar sin convertir (importes tal cual del proveedor)
FX_ENABLED="true"
FX_AUTO="true"
FX_REFRESH_HOURS="12"
# FX_RATES='{"USD":0.92,"GBP":1.17,"CNY":0.128}'
# FX_FEED_URL="https://api.frankfurter.app/latest?from=EUR&to=USD,GBP,CNY"  # otro feed

AUTH_ENABLED="false"

# ─── Stripe (suscripciones SaaS) ────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER="price_xxx"
STRIPE_PRICE_PRO="price_xxx"
STRIPE_PRICE_ENTERPRISE="price_xxx"

# ─── Catálogo (claves de la plataforma, opcional aquí) ───────────────────────
# Ver el bloque «Catálogo de la plataforma» al final de este archivo: lo normal es
# pegar las claves en Administración → Claves de proveedor.

# ─── Motor de sync (workers) ────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES="60"
SYNC_CONCURRENCY="8"
SYNC_MAX_PRODUCTS_PER_RUN="2000"
SYNC_PRICE_RULE_FALLBACK_PCT="40"

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="DropshipPilot"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Autenticación (NextAuth) ─────────────────────────────────────────────────
# Pon AUTH_ENABLED="true" para proteger el dashboard: el middleware redirige a /login.
# Sin AUTH_EMAIL/AUTH_PASSWORD definidos siguen valiendo las credenciales de demo
# (demo@dropshippilot.io / dropshippilot).
# AUTH_EMAIL="tu@email.com"
# AUTH_PASSWORD="una-contraseña-larga"
# AUTH_NAME="Tu nombre"

# ── Webhook entrante de WooCommerce ──────────────────────────────────────────
# El secreto se captura y cifra automáticamente al registrar los webhooks desde
# la página Tiendas. Define esto sólo si creas el webhook a mano en WordPress.
# WOO_WEBHOOK_SECRET=""
# WOO_ALLOW_UNSIGNED="false"   # true = aceptar webhooks sin firma (sólo para pruebas)

# ── Cobro alternativo: Lemon Squeezy (vendedor legal / merchant of record) ───
# Sirve para cobrar sin alta de autónomo: ellos emiten la factura y liquidan el
# IVA de cada país. Guía completa en PAGOS.md.
#   1. Crea la cuenta y los 6 productos (Starter/Pro/Enterprise × mes/año)
#   2. Copia la API key (Settings → API), el id de tienda (Settings → Stores)
#      y los ids de las variantes (cada producto tiene una por precio)
#   3. Settings → Webhooks → URL: https://TU-DOMINIO/api/webhooks/lemon
#      y copia el signing secret aquí abajo.
# LEMON_API_KEY=""
# LEMON_STORE_ID=""
# LEMON_WEBHOOK_SECRET=""
# LEMON_VARIANT_STARTER_MONTHLY=""
# LEMON_VARIANT_STARTER_YEARLY=""
# LEMON_VARIANT_PRO_MONTHLY=""
# LEMON_VARIANT_PRO_YEARLY=""
# LEMON_VARIANT_ENTERPRISE_MONTHLY=""
# LEMON_VARIANT_ENTERPRISE_YEARLY=""

# ── Shopify: instalación con un clic (OAuth) ─────────────────────────────────
# Crea una app gratis en partners.shopify.com (Apps → Create app), pon como URL
# de redirección https://TU-DOMINIO/api/shopify/callback y copia aquí:
# SHOPIFY_API_KEY=""
# SHOPIFY_API_SECRET=""
# SHOPIFY_OAUTH_SCOPES="read_products,write_products,read_orders,write_orders,read_inventory,write_inventory,read_fulfillments,write_fulfillments"

# ── Avisos por correo al cliente ─────────────────────────────────────────────
# Con RESEND_API_KEY (o MAIL_WEBHOOK_URL) los avisos de fallos de sync, stock,
# webhooks y pagos llegan por correo en vez de por consola.
# RESEND_API_KEY=""
# MAIL_FROM="DropshipPilot <avisos@tudominio.com>"

# ── Cadencia del motor 24/7 ──────────────────────────────────────────────────
# El planificador se despierta cada SYNC_SCHEDULER_MINUTES y re-verifica sólo los
# productos cuyo plan ya ha cumplido su intervalo (Prueba 360 min, Starter 120,
# Pro 60, Enterprise 30 — ver src/lib/plans.ts y la página Precios).
# SYNC_SCHEDULER_MINUTES="15"

# ── Catálogo de la plataforma (los clientes NO ponen claves) ─────────────────
# El operador configura las claves UNA vez —aquí o en Administración → Claves de
# proveedor— y todos los usuarios navegan e importan con ellas. Lo guardado en el
# panel (cifrado en la base de datos) tiene prioridad sobre estas variables.
# ALIEXPRESS_APP_KEY=""
# ALIEXPRESS_APP_SECRET=""
# ALIEXPRESS_ACCESS_TOKEN=""
# ALIEXPRESS_API_REGION="sg"        # sg (por defecto) | eu
# CJ_EMAIL=""
# CJ_API_KEY=""
# El worker de catálogo descarga productos cada CATALOG_SYNC_MINUTES y actualiza
# el escaparate. Sin claves, se muestra el catálogo de muestra (etiquetado).
# CATALOG_SYNC_MINUTES="360"
# CATALOG_SYNC_PAGES="2"            # páginas de 50 productos por proveedor
# CATALOG_SYNC_KEYWORD=""           # opcional: limitar la descarga a un tema
# CJ permite 1 petición por segundo: el catálogo se descarga con esta pausa
# entre páginas (y reintenta si aun así responde 429). No lo bajes de 1100.
# CATALOG_QPS_DELAY_MS="1200"

# ── Vigilancia del sistema (avisa al operador si algo se cae) ────────────────
# El worker comprueba base de datos, Redis, colas, microservicio de scraping y
# salud de la sincronización. Si algo va mal, envía un correo a los usuarios con
# rol ADMIN (con freno de una hora por problema). También a mano: npm run watchdog
# WATCHDOG_INTERVAL_MINUTES="15"
# WATCHDOG_QUEUE_WARN="500"          # trabajos en espera que disparan aviso
# WATCHDOG_FAILED_WARN="50"          # trabajos fallidos acumulados que disparan aviso
# WATCHDOG_FAILED_RATIO_PCT="30"     # % de fallos de sync en 1 h que dispara aviso
