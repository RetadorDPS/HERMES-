# ─────────────────────────────────────────────────────────────────────────────
#  DropshipPilot · configuración de PRODUCCIÓN
#
#  Normalmente NO edites este archivo a mano: ejecuta  ./scripts/deploy.sh
#  y él crea el .env.prod real con secretos aleatorios hechos para ti.
#
#  Cópialo como .env.prod sólo si prefieres rellenarlo tú.
# ─────────────────────────────────────────────────────────────────────────────

# ── Dominio y certificado HTTPS ──────────────────────────────────────────────
# El dominio debe tener un registro DNS tipo A apuntando a la IP del servidor.
DOMAIN="dropship.tudominio.com"
LETSENCRYPT_EMAIL="tu@email.com"

# ── Base de datos ────────────────────────────────────────────────────────────
POSTGRES_USER="autods"
POSTGRES_DB="autods"
POSTGRES_PASSWORD="cambia-esto-por-una-clave-larga"   # openssl rand -hex 32

# ── Secretos de la aplicación ────────────────────────────────────────────────
# ENCRYPTION_KEY cifra los tokens de tus tiendas (AES-256-GCM). Si la cambias,
# los tokens guardados dejan de poder descifrarse y habrá que reconectar tiendas.
ENCRYPTION_KEY="otra-clave-larga-aleatoria"
NEXTAUTH_SECRET="otra-mas"

# ── Acceso al panel ──────────────────────────────────────────────────────────
AUTH_EMAIL="tu@email.com"
AUTH_PASSWORD="contraseña-larga-del-panel"

# ── Webhooks ─────────────────────────────────────────────────────────────────
SHOPIFY_WEBHOOK_SECRET="secreto-para-firmar-webhooks-de-shopify"
# El de WooCommerce se captura automáticamente al registrar los webhooks desde la UI.
WOO_WEBHOOK_SECRET=""

# ── Comportamiento ───────────────────────────────────────────────────────────
SEED_DEMO_DATA="true"        # false = base de datos limpia (sin productos de ejemplo)
SYNC_INTERVAL_MINUTES="60"   # frecuencia del re-scan de proveedores
SYNC_CONCURRENCY="4"         # jobs en paralelo por worker
BACKUP_KEEP_DAYS="14"        # días de copias de seguridad conservadas
SCRAPER_MAX_CONCURRENCY="2"  # navegadores simultáneos (2 GB de RAM por Chromium aprox.)

# ── Extracción real de proveedores ───────────────────────────────────────────
# Recomendado: gateway residencial (Bright Data, Oxylabs, Smartproxy, IPRoyal, Webshare).
# Rellena los tres y la plataforma genera el pool rotativo sola.
PROXY_PROVIDER=""            # brightdata | oxylabs | smartproxy | iproyal | webshare | custom
PROXY_USERNAME=""
PROXY_PASSWORD=""
PROXY_COUNTRY="es"
PROXY_SESSIONS="12"
PROXY_SESSION_TTL_MIN="10"
PROXY_REQUIRED="false"       # true = nunca salir con la IP del servidor (falla en vez de arriesgar bloqueo)

# Alternativa sin proxies: API oficial
CJ_API_KEY=""
