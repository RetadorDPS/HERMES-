{
  "name": "autods-clone",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma SaaS de automatización de dropshipping (clon AutoDS) — Next.js 14 + Prisma + BullMQ + Scraper Playwright",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "worker": "tsx workers/index.ts",
    "worker:sync": "tsx workers/syncWorker.ts",
    "worker:orders": "tsx workers/orderWorker.ts",
    "scraper:install": "pip install -r services/scraper/requirements.txt",
    "scraper:dev": "cd services/scraper && uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "verify:e2e": "tsx scripts/verify-e2e.ts",
    "verify:isolation": "tsx scripts/verify-isolation.ts",
    "verify:credits": "tsx scripts/verify-credits.ts",
    "seed:demo": "tsx scripts/seed-demo-tenants.ts",
    "verify:2fa": "tsx scripts/verify-2fa.ts",
    "verify:backup": "bash scripts/verify-backup.sh",
    "verify:load": "tsx scripts/verify-load.ts",
    "verify:stripe": "tsx scripts/stripe-simulate-webhook.ts",
    "verify:webhooks": "tsx scripts/verify-webhooks.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "preflight": "tsx scripts/preflight.ts",
    "smoke": "tsx scripts/smoke.ts",
    "verify:lemon": "tsx scripts/verify-lemon.ts",
    "admin": "tsx scripts/make-admin.ts",
    "verify:admin": "tsx scripts/verify-admin.ts",
    "verify:alerts": "tsx scripts/verify-alerts.ts",
    "watchdog": "tsx scripts/watchdog.ts",
    "verify:ops": "tsx scripts/verify-ops.ts",
    "worker:catalog": "tsx workers/catalogWorker.ts",
    "verify:catalog": "tsx scripts/verify-catalog.ts",
    "seed:catalog": "tsx scripts/seed-catalog.ts",
    "verify:fx": "tsx scripts/verify-fx.ts",
    "fx:refresh": "tsx scripts/refresh-fx.ts",
    "verify:mail": "tsx scripts/verify-mail.ts",
    "mail:dev-server": "tsx scripts/dev-smtp-server.ts",
    "backup": "tsx scripts/backup.ts",
    "worker:backup": "tsx workers/backupWorker.ts",
    "verify:gdpr": "tsx scripts/verify-gdpr.ts",
    "verify:tour": "tsx scripts/verify-tour.ts",
    "verify:onboarding": "tsx scripts/verify-onboarding.ts",
    "worker:onboarding": "tsx workers/onboardingWorker.ts",
    "verify:onboarding-mail": "tsx scripts/verify-onboarding-mail.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "bullmq": "^5.34.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^18.0.8",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "next-auth": "^4.24.11",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "stripe": "^17.4.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
